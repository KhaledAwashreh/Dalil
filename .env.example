# Dalil Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# Atlassian OAuth (required for Confluence ingestion)
# Create an app at https://developer.atlassian.com/console/myapps/
# See docs/OAUTH.md for setup instructions
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# LLM provider (optional — Dalil works retrieval-only without one)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=

# MuninnDB (usually no changes needed)
MUNINN_TOKEN=

# Embedding provider (optional — MuninnDB uses local ONNX by default)
EMBED_PROVIDER=
EMBED_API_KEY=
